# HTML pages — short cache so fresh content is served quickly
/*.html
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Link: </assets/hero-grill-ds_jpqph.webp>; rel=preload; as=image; type=image/webp

# Global security + performance headers
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Assets: versioned hashes — cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon
/favicon.ico
  Cache-Control: public, max-age=604800
